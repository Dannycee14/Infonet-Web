 assets/site.css       |  71 ++++++++-
 cart.html             |  32 +++-
 checkout.html         |  29 +++-
 index.html            |  41 ++---
 products.html         | 125 +++++++++++++--
 services.html         |   8 +-
 styles.css            |  69 ++++++++
 tools/apply-chrome.py | 359 +++++++++++++++++++++++++++---------------
 tools/optimize.py     |   4 +-
 9 files changed, 565 insertions(+), 173 deletions(-)

